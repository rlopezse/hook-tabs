{
  "manifest_version": 3,
  "name": "Hook Tabs",
  "version": "0.7.1",
  "description": "Search. Find. Close. Pin. Done.",

  "permissions": [
    "tabs",
    "windows",
    "sessions"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "images/icon-128.png"
  },

  "commands": {
    "open-hook-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open Hook Tabs"
    }
  }
}
