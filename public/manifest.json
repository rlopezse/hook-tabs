{
  "manifest_version": 3,
  "name": "Hook Tabs",
  "version": "0.1.0",
  "description": "Hook Tabs helps you navigate your browser faster. Search across all your open tabs.",

  "permissions": [
    "tabs",
    "windows"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "128": "images/icon-128.png"
  },

  "commands": {
    "open-hook-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open Hook Tabs"
    }
  }
}
